{
  "name": "nomad-lens",
  "displayName": "Nomad Lens",
  "description": "HashiCorp Nomad operations inside VS Code: jobs/allocations/logs, plan diff between your repo job spec and the running one, one-click incident bundles, cluster snapshot reports.",
  "version": "1.7.0",
  "publisher": "allannava95",
  "license": "MIT",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Allan-Nava/nomad-lens"
  },
  "homepage": "https://allan-nava.github.io/nomad-lens/",
  "bugs": {
    "url": "https://github.com/Allan-Nava/nomad-lens/issues"
  },
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#0A1420",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "nomad",
    "hashicorp",
    "orchestrator",
    "devops",
    "operations"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nomadLens",
          "title": "Nomad",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nomadLens": [
        {
          "id": "nomadLens.explorer",
          "name": "Cluster"
        }
      ]
    },
    "commands": [
      {
        "command": "nomadLens.refresh",
        "title": "Nomad Lens: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "nomadLens.dashboard",
        "title": "Nomad Lens: Open Cluster Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "nomadLens.selectCluster",
        "title": "Nomad Lens: Select Cluster"
      },
      {
        "command": "nomadLens.filterJobs",
        "title": "Nomad Lens: Filter Jobs by Name",
        "icon": "$(filter)"
      },
      {
        "command": "nomadLens.toggleProblemsOnly",
        "title": "Nomad Lens: Show Problem Jobs Only (toggle)",
        "icon": "$(warning)"
      },
      {
        "command": "nomadLens.clearFilter",
        "title": "Nomad Lens: Clear Job Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "nomadLens.followLogs",
        "title": "Nomad Lens: Follow Task Logs"
      },
      {
        "command": "nomadLens.logConsole",
        "title": "Nomad Lens: Open Log Console"
      },
      {
        "command": "nomadLens.stopLogs",
        "title": "Nomad Lens: Stop Following Logs"
      },
      {
        "command": "nomadLens.planFile",
        "title": "Nomad Lens: Plan Current Job File (diff vs running)"
      },
      {
        "command": "nomadLens.incidentBundle",
        "title": "Nomad Lens: Export Incident Bundle for Allocation"
      },
      {
        "command": "nomadLens.snapshot",
        "title": "Nomad Lens: Cluster Snapshot Report"
      },
      {
        "command": "nomadLens.jobPanel",
        "title": "Nomad Lens: Open Job Panel"
      },
      {
        "command": "nomadLens.restartAlloc",
        "title": "Nomad Lens: Restart Allocation"
      },
      {
        "command": "nomadLens.stopJob",
        "title": "Nomad Lens: Stop Job"
      },
      {
        "command": "nomadLens.startJob",
        "title": "Nomad Lens: Start Job"
      },
      {
        "command": "nomadLens.explainPlacement",
        "title": "Nomad Lens: Explain Placement Failures"
      },
      {
        "command": "nomadLens.drainNode",
        "title": "Nomad Lens: Drain Node"
      },
      {
        "command": "nomadLens.stopDrain",
        "title": "Nomad Lens: Stop Draining Node"
      },
      {
        "command": "nomadLens.toggleEligibility",
        "title": "Nomad Lens: Toggle Node Scheduling Eligibility"
      },
      {
        "command": "nomadLens.resourceUsage",
        "title": "Nomad Lens: Resource Usage vs Requested"
      },
      {
        "command": "nomadLens.jobHistory",
        "title": "Nomad Lens: Job Version History (diff between versions)"
      },
      {
        "command": "nomadLens.revertJob",
        "title": "Nomad Lens: Revert Job to a Previous Version"
      },
      {
        "command": "nomadLens.grepJob",
        "title": "Nomad Lens: Grep Logs Across Allocations"
      },
      {
        "command": "nomadLens.compareClusters",
        "title": "Nomad Lens: Compare Job Across Clusters"
      },
      {
        "command": "nomadLens.imageInventory",
        "title": "Nomad Lens: Image Inventory (all clusters)"
      },
      {
        "command": "nomadLens.snapshotToFile",
        "title": "Nomad Lens: Save Cluster Snapshot to File"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nomadLens.refresh",
          "when": "view == nomadLens.explorer",
          "group": "navigation"
        },
        {
          "command": "nomadLens.filterJobs",
          "when": "view == nomadLens.explorer",
          "group": "navigation"
        },
        {
          "command": "nomadLens.toggleProblemsOnly",
          "when": "view == nomadLens.explorer",
          "group": "navigation"
        },
        {
          "command": "nomadLens.clearFilter",
          "when": "view == nomadLens.explorer"
        },
        {
          "command": "nomadLens.dashboard",
          "when": "view == nomadLens.explorer",
          "group": "navigation"
        },
        {
          "command": "nomadLens.snapshot",
          "when": "view == nomadLens.explorer"
        },
        {
          "command": "nomadLens.imageInventory",
          "when": "view == nomadLens.explorer"
        }
      ],
      "view/item/context": [
        {
          "command": "nomadLens.followLogs",
          "when": "view == nomadLens.explorer && viewItem == task"
        },
        {
          "command": "nomadLens.logConsole",
          "when": "view == nomadLens.explorer && viewItem == task"
        },
        {
          "command": "nomadLens.incidentBundle",
          "when": "view == nomadLens.explorer && viewItem =~ /^alloc/"
        },
        {
          "command": "nomadLens.restartAlloc",
          "when": "view == nomadLens.explorer && viewItem =~ /^alloc/"
        },
        {
          "command": "nomadLens.jobPanel",
          "when": "view == nomadLens.explorer && viewItem == job"
        },
        {
          "command": "nomadLens.stopJob",
          "when": "view == nomadLens.explorer && viewItem == job"
        },
        {
          "command": "nomadLens.startJob",
          "when": "view == nomadLens.explorer && viewItem == job"
        },
        {
          "command": "nomadLens.explainPlacement",
          "when": "view == nomadLens.explorer && viewItem == job"
        },
        {
          "command": "nomadLens.drainNode",
          "when": "view == nomadLens.explorer && viewItem =~ /^node-(eligible|ineligible)$/"
        },
        {
          "command": "nomadLens.stopDrain",
          "when": "view == nomadLens.explorer && viewItem == node-draining"
        },
        {
          "command": "nomadLens.toggleEligibility",
          "when": "view == nomadLens.explorer && viewItem =~ /^node-/"
        },
        {
          "command": "nomadLens.resourceUsage",
          "when": "view == nomadLens.explorer && viewItem == job"
        },
        {
          "command": "nomadLens.jobHistory",
          "when": "view == nomadLens.explorer && viewItem == job"
        },
        {
          "command": "nomadLens.revertJob",
          "when": "view == nomadLens.explorer && viewItem == job"
        },
        {
          "command": "nomadLens.grepJob",
          "when": "view == nomadLens.explorer && viewItem == job"
        },
        {
          "command": "nomadLens.compareClusters",
          "when": "view == nomadLens.explorer && viewItem == job"
        }
      ],
      "editor/title/context": [
        {
          "command": "nomadLens.planFile",
          "when": "resourceExtname == .nomad || resourceExtname == .hcl"
        }
      ]
    },
    "configuration": {
      "title": "Nomad Lens",
      "properties": {
        "nomadLens.clusters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "address": {
                "type": "string",
                "description": "http(s)://host:4646"
              },
              "namespace": {
                "type": "string"
              },
              "tokenEnv": {
                "type": "string",
                "description": "Name of the env var holding the ACL token (never store tokens in settings)"
              }
            },
            "required": [
              "name",
              "address"
            ]
          },
          "default": [
            {
              "name": "local",
              "address": "http://127.0.0.1:4646"
            }
          ],
          "description": "Nomad clusters. Tokens are read from the env var named in tokenEnv."
        },
        "nomadLens.autoFixGoVulncheck": {
          "type": "boolean",
          "default": true,
          "description": "On activation, fix the Go extension's broken go.diagnostic.vulncheck=\"Prompt\" default (gopls rejects it) by setting a valid value. Can be turned off."
        },
        "nomadLens.goVulncheckFixValue": {
          "type": "string",
          "enum": [
            "Off",
            "Imports"
          ],
          "default": "Off",
          "description": "Value used by the go.diagnostic.vulncheck auto-fix: \"Off\" (silent) or \"Imports\" (scan dependencies with govulncheck)."
        },
        "nomadLens.deploymentWatch": {
          "type": "boolean",
          "default": true,
          "description": "Watch active deployments: progress in the status bar + notification on success/failure/stall."
        },
        "nomadLens.deploymentPollSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "Deployment polling interval (seconds)."
        },
        "nomadLens.deploymentStallSeconds": {
          "type": "number",
          "default": 90,
          "minimum": 10,
          "description": "If a running deployment does not progress (healthy unchanged) for this long, it is reported as stalled."
        },
        "nomadLens.livePanels": {
          "type": "boolean",
          "default": true,
          "description": "Auto-refresh the dashboard and job panels on each deployment poll tick (in place, no reload)."
        },
        "nomadLens.snapshotPath": {
          "type": "string",
          "default": "",
          "description": "Path where the snapshot is written (Save Cluster Snapshot to File command). If it is a folder (or empty → the working folder) the file is nomad-snapshot-<cluster>-<date>.md; if it ends in .md it is the exact file. Supports ~."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node esbuild.mjs --test && node .test/run.mjs",
    "site": "node esbuild.mjs --site && node .site/build.cjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^7.0.2"
  }
}
